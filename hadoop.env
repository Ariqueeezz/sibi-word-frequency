
CORE_CONF_fs_defaultFS=hdfs://namenode:9000

HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname_check=false

YARN_CONF_yarn_resourcemanager_hostname=resourcemanager
YARN_CONF_yarn_nodemanager_aux___services=mapreduce_shuffle
YARN_CONF_yarn_nodemanager_resource_memory___mb=768
YARN_CONF_yarn_scheduler_minimum___allocation___mb=256
YARN_CONF_yarn_scheduler_maximum___allocation___mb=768

MAPRED_CONF_mapreduce_framework_name=yarn
MAPRED_CONF_mapred_child_java_opts=-Xmx256m
MAPRED_CONF_mapreduce_map_memory_mb=384
MAPRED_CONF_mapreduce_reduce_memory_mb=384
MAPRED_CONF_mapreduce_map_java_opts=-Xmx256m
MAPRED_CONF_mapreduce_reduce_java_opts=-Xmx256m

# Hadoop S3A - MinIO
HADOOP_CLASSPATH=/opt/hadoop-3.2.1/share/hadoop/tools/lib/*
CORE_CONF_fs_s3a_impl=org.apache.hadoop.fs.s3a.S3AFileSystem
CORE_CONF_fs_s3a_endpoint=http://minio:9000
CORE_CONF_fs_s3a_path_style_access=true
CORE_CONF_fs_s3a_connection_ssl_enabled=false
CORE_CONF_fs_s3a_aws_credentials_provider=org.apache.hadoop.fs.s3a.SimpleAWSCredentialsProvider

CORE_CONF_fs_s3a_access__key=${MINIO_ROOT_USER}
CORE_CONF_fs_s3a_secret__key=${MINIO_ROOT_PASSWORD}

MAPRED_CONF_yarn_app_mapreduce_am_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1
MAPRED_CONF_mapreduce_map_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1
MAPRED_CONF_mapreduce_reduce_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1

MAPRED_CONF_mapreduce_application_classpath=/opt/hadoop-3.2.1/share/hadoop/mapreduce/*,/opt/hadoop-3.2.1/share/hadoop/mapreduce/lib/*,/opt/hadoop-3.2.1/share/hadoop/tools/lib/*,/opt/hadoop-3.2.1/share/hadoop/common/*,/opt/hadoop-3.2.1/share/hadoop/common/lib/*,/opt/hadoop-3.2.1/share/hadoop/hdfs/*,/opt/hadoop-3.2.1/share/hadoop/hdfs/lib/*,/opt/hadoop-3.2.1/share/hadoop/yarn/*,/opt/hadoop-3.2.1/share/hadoop/yarn/lib/*
